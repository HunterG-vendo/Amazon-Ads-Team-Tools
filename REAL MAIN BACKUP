  // Close buttons — delegate to closeManager (already bound above)

  // ── INIT ─────────────────────────────────────────────────────────────
  // Always start on home page regardless of what state was exported
  document.getElementById('manager-overlay').classList.remove('open');
  document.getElementById('pw-gate').classList.remove('open');
  document.body.style.overflow = '';
  managerUnlocked = false;
  filterOpen = false;
  activeFilters = [];

  // Show version in footer
  var vEl = document.getElementById('page-version');
  if (vEl) {
    var vNum = STORE_VERSION.replace('v_', '');
    var vDate = isNaN(vNum) ? '' : new Date(parseInt(vNum)).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });
    vEl.textContent = vDate ? 'Published ' + vDate : '';
  }

  // Always reset push button to clean state on load
  var ghBtn = document.getElementById('gh-push-btn');
  if (ghBtn) { ghBtn.disabled = false; ghBtn.innerHTML = '&#8599;&nbsp; Push to GitHub'; }
  setGhStatus('', 'Ready to push');

  renderFilterBar();
  renderGrid();

})();
</script>



