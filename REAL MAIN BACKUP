<!DOCTYPE html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PLTFRM | Amazon Ads Team Tools</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&amp;display=swap" rel="stylesheet">
  <style>
    :root {
      --orange: #c8c8c8;
      --black: #080808;
      --surface: #101010;
      --surface2: #161616;
      --border: rgba(255,255,255,0.08);
      --border-hover: rgba(255,255,255,0.15);
      --text: rgba(255,255,255,0.90);
      --text-mid: rgba(255,255,255,0.52);
      --text-dim: rgba(255,255,255,0.25);
      --sans: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background: var(--black);
      color: var(--text);
      font-family: var(--sans);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── STATIC BACKGROUND ───────────────────────────────────────────────
       Multi-layer radial gradients fake the animated orb look perfectly.
       Zero JS, zero animation, zero backdrop-filter.                     */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background:
        /* Main centered glow */
        radial-gradient(ellipse 80% 60% at 50% 28%,
          rgba(200,200,200,0.21) 0%,
          rgba(170,170,170,0.10) 35%,
          rgba(120,120,120,0.04) 60%,
          transparent 78%
        ),
        /* Top-right accent */
        radial-gradient(ellipse 45% 40% at 94% 4%,
          rgba(200,200,200,0.13) 0%,
          rgba(150,150,150,0.05) 50%,
          transparent 72%
        ),
        /* Bottom-left accent */
        radial-gradient(ellipse 40% 32% at 4% 96%,
          rgba(150,150,150,0.10) 0%,
          transparent 68%
        );
    }

    /* ── LAYOUT ──────────────────────────────────────────────────────── */
    .page-wrap {
      position: relative;
      z-index: 10;
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 32px;
    }

    /* ── HEADER ──────────────────────────────────────────────────────── */
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      padding: 0 32px;
      background: linear-gradient(180deg, rgba(20,12,8,0.97) 0%, rgba(10,8,6,0.96) 100%);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      box-shadow:
        0 1px 0 rgba(255,255,255,0.05) inset,
        0 0 0 1px rgba(200,200,200,0.06),
        0 4px 32px rgba(0,0,0,0.5);
    }

    .header-inner {
      max-width: 1120px;
      margin: 0 auto;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Static dot — glowing but not animated */
    .logo-dot {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--orange);
      box-shadow: 0 0 6px 2px rgba(200,200,200,0.6), 0 0 14px rgba(200,200,200,0.3);
    }

    .manage-btn {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 500;
      color: var(--text-mid);
      background: linear-gradient(160deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.03) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 8px 18px;
      border-radius: 100px;
      cursor: pointer;
      box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 2px 8px rgba(0,0,0,0.3);
      transition: border-color 0.18s, color 0.18s, box-shadow 0.18s;
    }
    .manage-btn:hover {
      border-color: rgba(255,255,255,0.18);
      color: var(--text);
      box-shadow: 0 1px 0 rgba(255,255,255,0.08) inset, 0 2px 12px rgba(0,0,0,0.4), 0 0 16px rgba(200,200,200,0.08);
    }

    /* ── HERO ────────────────────────────────────────────────────────── */
    .hero {
      position: relative;
      z-index: 10;
      padding: 80px 0 56px;
      text-align: center;
    }

    .hero h1 {
      font-size: clamp(34px, 5.5vw, 70px);
      font-weight: 300;
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: var(--text);
      white-space: nowrap;
    }

    .hero h1 strong {
      font-weight: 600;
      color: var(--orange);
    }

    /* ── CONTROLS ROW ────────────────────────────────────────────────── */
    .controls-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
      flex-wrap: wrap;
    }

    .search-wrap {
      position: relative;
      flex: 1;
      min-width: 180px;
    }
    .search-icon {
      position: absolute;
      left: 13px; top: 50%;
      transform: translateY(-50%);
      width: 13px; height: 13px;
      color: var(--text-dim);
      pointer-events: none;
      flex-shrink: 0;
    }
    .search-input {
      width: 100%;
      background: linear-gradient(160deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.03) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--text);
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 400;
      padding: 8px 36px 8px 34px;
      border-radius: 100px;
      outline: none;
      box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 2px 8px rgba(0,0,0,0.3);
      transition: border-color 0.18s, box-shadow 0.18s;
    }
    .search-input::placeholder { color: var(--text-dim); }
    .search-input:focus {
      border-color: rgba(200,200,200,0.4);
      box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 2px 12px rgba(0,0,0,0.35), 0 0 0 3px rgba(200,200,200,0.08);
    }
    .search-clear {
      position: absolute;
      right: 12px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none;
      color: var(--text-dim); font-size: 12px;
      cursor: pointer; line-height: 1; padding: 2px;
      transition: color 0.15s;
    }
    .search-clear:hover { color: var(--text-mid); }

    .sort-wrap {
      position: relative;
      flex-shrink: 0;
    }
    .sort-icon {
      position: absolute;
      left: 13px; top: 50%;
      transform: translateY(-50%);
      width: 13px; height: 13px;
      color: var(--text-dim);
      pointer-events: none;
    }
    .sort-select {
      appearance: none;
      -webkit-appearance: none;
      background: linear-gradient(160deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.03) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      color: var(--text-mid);
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 500;
      padding: 8px 32px 8px 34px;
      border-radius: 100px;
      outline: none;
      cursor: pointer;
      box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 2px 8px rgba(0,0,0,0.3);
      transition: border-color 0.18s, color 0.18s;
    }
    .sort-select:focus { border-color: rgba(200,200,200,0.4); }
    .sort-select option { background: #1a1a1a; color: var(--text); }
    /* chevron */
    .sort-wrap::after {
      content: '›';
      position: absolute;
      right: 13px; top: 50%;
      transform: translateY(-50%) rotate(90deg);
      color: var(--text-dim);
      font-size: 13px;
      pointer-events: none;
    }

    /* ── FILTER ──────────────────────────────────────────────────────── */
    .filter-wrap {
      position: relative;
      z-index: 10;
      margin-bottom: 20px;
    }

    .filter-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 500;
      color: var(--text-mid);
      background: linear-gradient(160deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.03) 100%);
      border: 1px solid rgba(255,255,255,0.1);
      padding: 8px 18px;
      border-radius: 100px;
      cursor: pointer;
      box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 2px 8px rgba(0,0,0,0.3);
      transition: border-color 0.18s, color 0.18s, box-shadow 0.18s, background 0.18s;
      user-select: none;
    }
    .filter-toggle-btn:hover {
      border-color: rgba(255,255,255,0.18);
      color: var(--text);
      box-shadow: 0 1px 0 rgba(255,255,255,0.08) inset, 0 2px 12px rgba(0,0,0,0.4);
    }
    .filter-toggle-btn.open {
      border-color: rgba(200,200,200,0.45);
      color: #e8e8e8;
      background: linear-gradient(160deg, rgba(200,200,200,0.13) 0%, rgba(200,200,200,0.06) 100%);
      box-shadow: 0 1px 0 rgba(220,220,220,0.08) inset, 0 2px 12px rgba(0,0,0,0.35), 0 0 18px rgba(200,200,200,0.12);
    }

    .filter-toggle-btn svg {
      width: 13px; height: 13px;
      stroke: currentColor; stroke-width: 1.8;
      fill: none; stroke-linecap: round; flex-shrink: 0;
    }

    .filter-active-label { font-size: 11px; color: rgba(255,184,153,0.65); }

    .filter-pills-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.28s ease, opacity 0.2s ease;
    }
    .filter-pills-row.open { max-height: 160px; opacity: 1; }

    .filter-pill {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 400;
      padding: 6px 16px;
      border-radius: 100px;
      border: 1px solid rgba(255,255,255,0.09);
      background: linear-gradient(160deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
      box-shadow: 0 1px 0 rgba(255,255,255,0.05) inset, 0 2px 6px rgba(0,0,0,0.25);
      color: var(--text-mid);
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s, box-shadow 0.15s;
      white-space: nowrap;
    }
    .filter-pill:hover {
      border-color: rgba(255,255,255,0.18);
      color: var(--text);
      box-shadow: 0 1px 0 rgba(255,255,255,0.07) inset, 0 2px 10px rgba(0,0,0,0.35);
    }

    /* ── TOOLS GRID ──────────────────────────────────────────────────── */
    .tools-section { position: relative; z-index: 10; padding-bottom: 80px; }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 12px;
    }

    /* Cards — glass lookalike via layered box-shadow + shine, NO backdrop-filter */
    .tool-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 26px 26px 22px;
      border-radius: 18px;
      /* Layered border: subtle white rim + orange glow underneath */
      border: 1px solid rgba(255,255,255,0.09);
      /* Glass-depth via background gradient */
      background: linear-gradient(
        160deg,
        rgba(255,255,255,0.055) 0%,
        rgba(255,255,255,0.025) 50%,
        rgba(200,200,200,0.03) 100%
      );
      /* Depth shadow */
      box-shadow:
        0 2px 0 rgba(255,255,255,0.05) inset,   /* top inner highlight */
        0 1px 3px rgba(0,0,0,0.4),
        0 8px 32px rgba(0,0,0,0.35);
      text-decoration: none;
      color: inherit;
      transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
      will-change: transform;
    }

    /* Shine stripe across top — fakes the glass specular highlight */
    .tool-card::before {
      content: '';
      position: absolute;
      top: 0; left: 12px; right: 12px;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
      border-radius: 1px;
    }

    /* Orange rim glow on hover */
    .tool-card::after {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 19px;
      border: 1px solid rgba(200,200,200,0);
      transition: border-color 0.2s, box-shadow 0.2s;
      pointer-events: none;
    }

    .tool-card:hover {
      border-color: rgba(255,255,255,0.14);
      transform: translateY(-3px);
      box-shadow:
        0 2px 0 rgba(255,255,255,0.06) inset,
        0 2px 4px rgba(0,0,0,0.5),
        0 16px 48px rgba(0,0,0,0.45),
        0 0 40px rgba(200,200,200,0.07);
    }
    .tool-card:hover::after {
      border-color: rgba(200,200,200,0.3);
      box-shadow: 0 0 18px rgba(200,200,200,0.1);
    }

    .tool-card-top { display: flex; justify-content: space-between; align-items: flex-start; }
    .tool-number { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; color: var(--text-dim); }

    .tool-arrow {
      width: 28px; height: 28px;
      border-radius: 50%;
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; color: var(--text-dim);
      transition: border-color 0.18s, color 0.18s, background 0.18s;
      flex-shrink: 0;
    }
    .tool-card:hover .tool-arrow {
      border-color: rgba(200,200,200,0.4);
      background: rgba(200,200,200,0.1);
      color: #e8e8e8;
    }

    .tool-name { font-size: 18px; font-weight: 600; color: var(--text); line-height: 1.25; letter-spacing: -0.01em; }
    .tool-desc { font-size: 13px; font-weight: 300; color: var(--text-mid); line-height: 1.65; flex: 1; }
    .tool-author { font-size: 12px; color: var(--text-dim); }
    .tool-author span { color: var(--text-mid); }

    .tool-card-footer {
      display: flex; align-items: flex-start; gap: 10px;
      padding-top: 12px; border-top: 1px solid var(--border);
    }
    .tool-tags { display: flex; flex-wrap: wrap; gap: 6px; flex: 1; }
    .tool-tag {
      font-size: 11px; font-weight: 400;
      letter-spacing: 0.03em;
      border-radius: 100px;
      padding: 3px 10px;
    }

    /* ── EMPTY ───────────────────────────────────────────────────────── */
    .empty-state {
      grid-column: 1 / -1; text-align: center;
      padding: 80px 20px; color: var(--text-dim);
      font-size: 14px; font-weight: 300;
    }

    /* ── FOOTER ──────────────────────────────────────────────────────── */
    footer {
      position: relative; z-index: 10;
      display: flex; justify-content: space-between; align-items: center;
      padding: 40px 32px;
      color: var(--text-dim); font-size: 12px;
      border-top: 1px solid var(--border);
    }

    /* ── MANAGER OVERLAY ─────────────────────────────────────────────── */
    .overlay {
      position: fixed; inset: 0; z-index: 100;
      overflow-y: auto;
      padding: 32px 20px;
      /* Solid overlay — no backdrop-filter */
      background: rgba(0,0,0,0.82);
      display: flex; align-items: flex-start; justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.18s ease;
    }
    .overlay.open { opacity: 1; pointer-events: auto; }

    .manager-panel {
      position: relative;
      width: 100%; max-width: 660px;
      background: #111;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px;
      padding: 36px;
      box-shadow: 0 32px 80px rgba(0,0,0,0.9);
      transform: translateY(10px);
      transition: transform 0.22s ease;
    }
    .overlay.open .manager-panel { transform: translateY(0); }

    .manager-header {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 28px;
    }
    .manager-eyebrow {
      font-size: 11px; font-weight: 500;
      letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--orange); margin-bottom: 6px;
    }
    .manager-title {
      font-size: 24px; font-weight: 600; letter-spacing: -0.02em; color: var(--text);
    }
    .close-btn {
      width: 30px; height: 30px; border-radius: 50%;
      background: var(--surface2); border: 1px solid var(--border);
      color: var(--text-mid); font-size: 13px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.15s, color 0.15s; flex-shrink: 0; margin-top: 2px;
    }
    .close-btn:hover { background: #222; color: var(--text); }

    /* TABS */
    .manager-tabs {
      display: flex; gap: 4px; margin-bottom: 28px;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 10px; padding: 4px;
    }
    .manager-tab {
      flex: 1; font-family: var(--sans); font-size: 13px; font-weight: 500;
      color: var(--text-dim); background: none; border: none;
      padding: 8px 10px; border-radius: 7px; cursor: pointer;
      transition: background 0.15s, color 0.15s; white-space: nowrap;
    }
    .manager-tab:hover { color: var(--text-mid); background: rgba(255,255,255,0.04); }
    .manager-tab.active { background: #222; color: var(--text); }
    .tab-pane { display: none; }
    .tab-pane.active { display: block; }

    /* FORM */
    .section-label {
      font-size: 11px; font-weight: 500; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--orange);
      margin-bottom: 14px; padding-bottom: 10px;
      border-bottom: 1px solid rgba(200,200,200,0.15);
    }
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 12px; font-weight: 500; color: var(--text-mid); margin-bottom: 6px; }
    .form-hint { font-size: 11px; color: var(--text-dim); margin-top: 6px; line-height: 1.5; }

    .form-input, .form-textarea {
      width: 100%; background: var(--surface2);
      border: 1px solid var(--border); color: var(--text);
      font-family: var(--sans); font-size: 13px; font-weight: 300;
      padding: 10px 13px; border-radius: 9px;
      outline: none; resize: vertical;
      transition: border-color 0.15s;
    }
    .form-input::placeholder, .form-textarea::placeholder { color: var(--text-dim); }
    .form-input:focus, .form-textarea:focus { border-color: rgba(200,200,200,0.45); }
    .form-textarea { min-height: 74px; line-height: 1.6; }

    /* TAG CHIPS */
    .tag-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
    .tag-chip {
      font-family: var(--sans); font-size: 12px; font-weight: 400;
      color: var(--text-mid); cursor: pointer;
      background: var(--surface2); border: 1px solid var(--border);
      padding: 5px 13px; border-radius: 100px;
      transition: border-color 0.15s, color 0.15s, background 0.15s;
      user-select: none;
    }
    .tag-chip:hover { border-color: var(--border-hover); color: var(--text); }

    /* TOOLS LIST */
    .tools-list { margin-bottom: 8px; }
    .tool-list-item {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .tool-list-name { font-size: 14px; font-weight: 500; color: var(--text); flex: 1; min-width: 120px; }
    .tool-list-author { font-size: 11px; color: var(--text-dim); white-space: nowrap; }

    /* EDIT ROW */
    .edit-row {
      width: 100%; background: rgba(255,255,255,0.03);
      border: 1px solid var(--border); border-radius: 10px;
      padding: 14px; margin: 6px 0 8px;
    }
    .edit-row .form-input, .edit-row .form-textarea { margin-bottom: 8px; }
    .edit-row-btns { display: flex; gap: 8px; margin-top: 4px; }

    /* BUTTONS */
    .btn { font-family: var(--sans); font-size: 13px; font-weight: 500; padding: 10px 22px; border-radius: 100px; cursor: pointer; border: none; transition: background 0.15s, box-shadow 0.15s, transform 0.15s; }
    .btn-primary { background: var(--orange); color: #111; }
    .btn-primary:hover { background: #aaaaaa; transform: translateY(-1px); }
    .btn-secondary { background: var(--surface2); border: 1px solid var(--border); color: var(--text-mid); }
    .btn-secondary:hover { border-color: var(--border-hover); color: var(--text); }

    .btn-danger { background: none; border: 1px solid rgba(255,80,80,0.2); color: rgba(255,120,120,0.6); font-family: var(--sans); font-size: 11px; padding: 5px 12px; border-radius: 100px; cursor: pointer; transition: border-color 0.15s, color 0.15s; }
    .btn-danger:hover { border-color: rgba(255,80,80,0.55); color: #ff8080; }

    .btn-edit { background: none; border: 1px solid var(--border); color: var(--text-dim); font-family: var(--sans); font-size: 11px; padding: 5px 12px; border-radius: 100px; cursor: pointer; transition: border-color 0.15s, color 0.15s; }
    .btn-edit:hover { border-color: var(--border-hover); color: var(--text-mid); }

    .edit-save-btn { font-family: var(--sans); font-size: 12px; font-weight: 500; background: var(--orange); color: #111; border: none; padding: 7px 16px; border-radius: 100px; cursor: pointer; transition: background 0.15s; }
    .edit-save-btn:hover { background: #aaaaaa; }
    .edit-cancel-btn { font-family: var(--sans); font-size: 12px; background: none; border: 1px solid var(--border); color: var(--text-dim); padding: 7px 14px; border-radius: 100px; cursor: pointer; transition: color 0.15s; }
    .edit-cancel-btn:hover { color: var(--text-mid); }

    .form-actions { display: flex; gap: 10px; margin-top: 10px; }

    /* NEW CAT ROW */
    .new-cat-row { display: flex; gap: 8px; }
    .new-cat-row .form-input { flex: 1; }
    .btn-add-cat {
      font-family: var(--sans); font-size: 12px; font-weight: 500;
      background: rgba(200,200,200,0.12); border: 1px solid rgba(200,200,200,0.25);
