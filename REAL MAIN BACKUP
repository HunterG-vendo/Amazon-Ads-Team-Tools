    .pw-gate {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(0,0,0,0.88);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none; transition: opacity 0.18s;
    }
    .pw-gate.open { opacity: 1; pointer-events: auto; }
    .pw-box {
      background: #111; border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px; padding: 36px 32px; width: 100%; max-width: 340px;
      box-shadow: 0 32px 80px rgba(0,0,0,0.9);
      transform: translateY(8px); transition: transform 0.22s;
    }
    .pw-gate.open .pw-box { transform: translateY(0); }
    .pw-eyebrow { font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--orange); margin-bottom: 6px; }
    .pw-title { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; color: var(--text); margin-bottom: 6px; }
    .pw-sub { font-size: 13px; color: var(--text-mid); margin-bottom: 24px; }
    .pw-error { font-size: 12px; color: #f87171; margin-top: 8px; min-height: 18px; }
    .pw-wrap { position: relative; }
    .pw-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; font-size: 11px; color: var(--text-dim); cursor: pointer; font-family: var(--sans); }

    /* Locked settings — readonly handles interaction, opacity shows state */
