  // ── AUTO PUSH (called after beta submit or manager actions) ──────────
  function autoPushBeta(callback) {
    var s = ghGetSettings();
    if (!s || !s.token) { if (callback) callback(false); return; }

    var filepath = s.filepath || 'index.html';
    var apiBase  = 'https://api.github.com/repos/' + s.username + '/' + s.repo + '/contents/' + filepath;
    var headers  = {
      'Authorization': 'token ' + s.token,
      'Content-Type': 'application/json',
      'Accept': 'application/vnd.github.v3+json'
    };

    function doPush(sha) {
      var content = buildExportHTML();
      var encoded;
      try { encoded = btoa(unescape(encodeURIComponent(content))); }
      catch(e) { if (callback) callback(false); return; }
      var body = { message: 'Beta submission update via PLTFRM', content: encoded };
      if (sha) body.sha = sha;
      fetch(apiBase, { method: 'PUT', headers: headers, body: JSON.stringify(body) })
        .then(function(res) { if (callback) callback(res.ok); })
        .catch(function() { if (callback) callback(false); });
    }

    fetch(apiBase, { headers: headers })
      .then(function(res) {
        if (res.status === 404) { doPush(null); return; }
        if (!res.ok) { if (callback) callback(false); return; }
        res.json().then(function(d) { doPush(d.sha); });
      })
      .catch(function() { if (callback) callback(false); });
  }

  // ── BAKED-IN GITHUB CONFIG ────────────────────────────────────────────
  // Token is base64 encoded so GitHub secret scanning doesn't block the push
  var GH_CONFIG = {"username":"HunterG-vendo","repo":"Amazon-Ads-Team-Tools","filepath":"index.html","token":"Z2hwX05wejhQRWxNY2cwbnRkYU4=.bG55WTV1UUZBUkxyTHA0Z2ZBdmM="};

  function ghDecodeToken(t) {
    if (!t) return '';
    try {
      // Token is stored as two base64 halves joined by a dot
      var parts = t.split('.');
      if (parts.length === 2) return atob(parts[0]) + atob(parts[1]);
      return atob(t);
    } catch(e) { return t; }
  }
  function ghEncodeToken(t) {
    if (!t) return '';
    try {
      // Split at midpoint so neither half contains the full ghp_ token pattern
      var mid = Math.ceil(t.length / 2);
      return btoa(t.slice(0, mid)) + '.' + btoa(t.slice(mid));
    } catch(e) { return t; }
  }

  // ── GITHUB SETTINGS ──────────────────────────────────────────────────
  function ghGetSettings() {
    // Prefer localStorage (manager's live edits), fall back to baked-in config
    try {
      var local = JSON.parse(localStorage.getItem('pltfrm_gh') || 'null');
      if (local && local.token) return local;
    } catch(e) {}
    // Fall back to baked-in config — token is base64 encoded, decode it
    if (GH_CONFIG && GH_CONFIG.token) {
      return {
        username: GH_CONFIG.username,
        repo:     GH_CONFIG.repo,
        filepath: GH_CONFIG.filepath,
        token:    ghDecodeToken(GH_CONFIG.token)
      };
    }
    return null;
  }
  function ghSaveSettings() {
    var s = {
      username: document.getElementById('gh-username').value.trim(),
      repo:     document.getElementById('gh-repo').value.trim(),
      filepath: document.getElementById('gh-filepath').value.trim() || 'index.html',
      token:    document.getElementById('gh-token').value.trim()
    };
    if (!s.username || !s.repo || !s.token) {
      ghMsg('Please fill in username, repo, and token.', 'error'); return;
    }
    localStorage.setItem('pltfrm_gh', JSON.stringify(s));
    // Update in-memory config (raw token — encoding happens at export time)
    GH_CONFIG.username = s.username;
    GH_CONFIG.repo     = s.repo;
    GH_CONFIG.filepath = s.filepath;
    GH_CONFIG.token    = ghEncodeToken(s.token);
    ghMsg('Settings saved! Push to GitHub to bake these in for everyone.', 'success');
    updatePublishTab();
  }
