  function submitBeta() {
    var name   = document.getElementById('beta-name').value.trim();
    var url    = document.getElementById('beta-url').value.trim();
    var desc   = document.getElementById('beta-desc').value.trim();
    var author = document.getElementById('beta-author').value.trim();
    var notes  = document.getElementById('beta-notes').value.trim();
    var tags   = [];
    document.querySelectorAll('#beta-tag-chips .tag-chip.checked').forEach(function(el) {
      tags.push(el.getAttribute('data-cat'));
    });
    if (!name || !url) { alert('Tool Name and URL are required.'); return; }
    var beta = {
      id: 'b'+Date.now(), name: name, url: url, desc: desc,
      author: author || 'Anonymous', tags: tags, notes: notes,
      status: 'pending', comments: [], submittedAt: new Date().toISOString()
    };
    betas.push(beta);
    saveBetas();
    logUpdate('beta', '"'+name+'" submitted for review by '+beta.author, '#a78bfa');
    // Reset form
    ['beta-name','beta-url','beta-desc','beta-author','beta-notes'].forEach(function(id) {
      document.getElementById(id).value = '';
    });
    document.querySelectorAll('#beta-tag-chips .tag-chip').forEach(function(el) {
      el.classList.remove('checked'); el.style.background=''; el.style.borderColor=''; el.style.color='';
    });
    // Show status view
    renderBetaStatusList();
    document.getElementById('beta-form-section').style.display = 'none';
    document.getElementById('beta-status-section').style.display = 'block';

    // Auto-push to GitHub so everyone sees the new beta
    var s = ghGetSettings();
    if (s && s.token) {
      var submitBtn = document.getElementById('beta-submit-btn');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Pushing…'; }
      autoPushBeta(function(ok) {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Submit for Review'; }
        if (!ok) {
          // Show soft warning — beta is saved locally even if push failed
          var statusList = document.getElementById('beta-status-list');
          if (statusList) {
            var warn = document.createElement('div');
            warn.style.cssText = 'font-size:11px;color:#fbbf24;margin-top:8px;';
            warn.textContent = '⚠ Could not push to GitHub automatically. Manager can push manually from Publish tab.';
            statusList.prepend(warn);
          }
        }
      });
    }
  }

