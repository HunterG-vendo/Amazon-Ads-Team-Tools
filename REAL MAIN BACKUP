  function handleBetaAction(e) {
    // Approve / push live
    var approveBtn = e.target.closest('[data-approve]');
    if (approveBtn) {
      var id = approveBtn.getAttribute('data-approve');
      var beta = betas.find(function(b) { return b.id === id; });
      if (!beta) return;
      // Move to main tools
      var newId = 'bt'+Date.now();
      tools.push({ id: newId, name: beta.name, url: beta.url, desc: beta.desc, tags: beta.tags||[], author: beta.author });
      beta.status = 'approved';
      save(); saveBetas();
      logUpdate('approved', '"'+beta.name+'" approved and pushed live', '#34d399');
      renderAll(); renderBetasTab();
      autoPushBeta(null);
      return;
    }
    // Deny
    var denyBtn = e.target.closest('[data-deny]');
    if (denyBtn) {
      var id = denyBtn.getAttribute('data-deny');
      var beta = betas.find(function(b) { return b.id === id; });
      if (!beta) return;
      beta.status = 'denied';
      saveBetas();
      logUpdate('denied', '"'+beta.name+'" denied by manager', '#f87171');
      renderBetasTab();
      autoPushBeta(null);
      return;
    }
    // Delete beta
    var deleteBtn = e.target.closest('[data-delete-beta]');
    if (deleteBtn) {
      var id = deleteBtn.getAttribute('data-delete-beta');
      if (deleteBtn.getAttribute('data-confirming') === '1') {
        var beta = betas.find(function(b) { return b.id === id; });
        if (beta) {
          betas = betas.filter(function(b) { return b.id !== id; });
          saveBetas();
          logUpdate('deleted', '"'+beta.name+'" beta deleted', '#888');
          renderBetasTab();
        }
      } else {
        deleteBtn.setAttribute('data-confirming', '1');
        deleteBtn.textContent = 'Sure?';
        setTimeout(function() {
          if (deleteBtn && deleteBtn.getAttribute('data-confirming') === '1') {
            deleteBtn.setAttribute('data-confirming', '0');
            deleteBtn.textContent = 'Delete';
          }
        }, 3000);
      }
      return;
    }
    // Add comment
    var commentBtn = e.target.closest('[data-add-comment]');
    if (commentBtn) {
      var id    = commentBtn.getAttribute('data-add-comment');
      var input = document.querySelector('[data-comment-input="'+id+'"]');
      var text  = input ? input.value.trim() : '';
      if (!text) return;
      var beta = betas.find(function(b) { return b.id === id; });
      if (!beta) return;
      if (!beta.comments) beta.comments = [];
      beta.comments.push({ text: text, time: new Date().toISOString() });
      saveBetas();
      logUpdate('comment', 'Comment on "'+beta.name+'": '+text.slice(0,60)+(text.length>60?'…':''), '#4f9eff');
      renderBetasTab();
      renderBetaStatusList();
      autoPushBeta(null);
      return;
    }
  }

