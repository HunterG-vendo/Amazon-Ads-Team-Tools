    var current = document.getElementById('pw-current').value;
    var newPw   = document.getElementById('pw-new').value;
    var confirm = document.getElementById('pw-confirm').value;
    var msg     = document.getElementById('pw-change-msg');
    msg.style.display = 'block';

    if (current !== getPassword()) {
      msg.style.color = '#f87171'; msg.textContent = 'Current password is incorrect.'; return;
    }
    if (!newPw || newPw.length < 4) {
      msg.style.color = '#f87171'; msg.textContent = 'New password must be at least 4 characters.'; return;
    }
    if (newPw !== confirm) {
      msg.style.color = '#f87171'; msg.textContent = 'New passwords do not match.'; return;
    }
    localStorage.setItem('pltfrm_pw', newPw);
    msg.style.color = '#34d399'; msg.textContent = 'Password changed successfully.';
