    var sv = localStorage.getItem('pltfrm_v');
    if (sv !== STORE_VERSION) {
      // Version mismatch — clear stale data so defaults load fresh
      localStorage.removeItem('pltfrm_tools');
      localStorage.removeItem('pltfrm_cats');
      localStorage.setItem('pltfrm_v', STORE_VERSION);
    }
    var st = localStorage.getItem('pltfrm_tools');
    var sc = localStorage.getItem('pltfrm_cats');
    tools      = st ? JSON.parse(st) : JSON.parse(JSON.stringify(DEFAULT_TOOLS));
    categories = sc ? JSON.parse(sc) : JSON.parse(JSON.stringify(DEFAULT_PALETTE));
  } catch(e) {
    tools      = JSON.parse(JSON.stringify(DEFAULT_TOOLS));
    categories = JSON.parse(JSON.stringify(DEFAULT_PALETTE));
  }

  var activeFilter = 'All';
  var editingIdx   = -1;
  var filterOpen   = false;

  function save() {
    try {
      localStorage.setItem('pltfrm_tools', JSON.stringify(tools));
      localStorage.setItem('pltfrm_cats',  JSON.stringify(categories));
    } catch(e) {}
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function pad(n) { return n < 10 ? '0' + n : '' + n; }

  function getCatColor(name) {
    for (var i = 0; i < categories.length; i++) {
      if (categories[i].name === name) return categories[i].color;
    }
    return '#666';
  }

  function hexAlpha(hex, a) {
    var r = parseInt(hex.slice(1,3),16);
    var g = parseInt(hex.slice(3,5),16);
    var b = parseInt(hex.slice(5,7),16);
    return 'rgba('+r+','+g+','+b+','+a+')';
  }

  // ── FILTER ───────────────────────────────────────────────────────────
  function toggleFilter() {
    filterOpen = !filterOpen;
    document.getElementById('filter-toggle-btn').classList.toggle('open', filterOpen);
    document.getElementById('filter-bar').classList.toggle('open', filterOpen);
  }

  function updateActiveLabel() {
    var el = document.getElementById('filter-active-label');
    if (activeFilter !== 'All') {
      var col = getCatColor(activeFilter);
      el.innerHTML = '&mdash; <span style="color:' + col + '">' + esc(activeFilter) + '</span>';
    } else {
      el.innerHTML = '';
    }
  }

  function renderFilterBar() {
    var bar = document.getElementById('filter-bar');
    var html = '';
    var allActive = activeFilter === 'All';
    html += '<button class="filter-pill" data-cat="All" style="'
      + (allActive ? 'background:rgba(232,92,42,0.15);border-color:rgba(232,92,42,0.4);color:#ffb899;' : '')
      + '">All</button>';
    categories.forEach(function(cat) {
      var isActive = cat.name === activeFilter;
      var col = cat.color;
      var style = isActive
        ? 'background:'+hexAlpha(col,0.15)+';border-color:'+hexAlpha(col,0.5)+';color:'+col+';'
        : 'border-color:'+hexAlpha(col,0.25)+';color:'+hexAlpha(col,0.7)+';';
      html += '<button class="filter-pill" data-cat="'+esc(cat.name)+'" style="'+style+'">'
        + '<span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:'+col+';margin-right:6px;vertical-align:middle;"></span>'
        + esc(cat.name) + '</button>';
    });
    bar.innerHTML = html;
    updateActiveLabel();
  }

  // ── GRID ─────────────────────────────────────────────────────────────
  function renderGrid() {
    var grid = document.getElementById('tools-grid');
    var query = (document.getElementById('search-input').value || '').toLowerCase().trim();
    var sortVal = document.getElementById('sort-select').value;

    // 1. Filter by active tag
    var list = activeFilter === 'All' ? tools.slice() : tools.filter(function(t) {
      return Array.isArray(t.tags) && t.tags.indexOf(activeFilter) !== -1;
    });

    // 2. Filter by search query
    if (query) {
      list = list.filter(function(t) {
        return t.name.toLowerCase().indexOf(query) !== -1
          || (t.desc && t.desc.toLowerCase().indexOf(query) !== -1)
          || (t.author && t.author.toLowerCase().indexOf(query) !== -1);
      });
    }

    // 3. Sort
    if (sortVal === 'alpha') {
      list.sort(function(a,b){ return a.name.localeCompare(b.name); });
    } else if (sortVal === 'alpha-desc') {
      list.sort(function(a,b){ return b.name.localeCompare(a.name); });
    } else if (sortVal === 'author') {
      list.sort(function(a,b){ return (a.author||'').localeCompare(b.author||''); });
    }

    if (!list.length) {
      var msg = query ? 'No tools match &ldquo;' + esc(query) + '&rdquo;.' : 'No tools in &ldquo;' + esc(activeFilter) + '&rdquo; yet.';
      grid.innerHTML = '<div class="empty-state">' + msg + '</div>';
      return;
    }
    var html = '';
    list.forEach(function(t, i) {
      var tagHtml = '';
      (t.tags || []).forEach(function(tag) {
        var col = getCatColor(tag);
        tagHtml += '<span class="tool-tag" style="color:'+col+';background:'+hexAlpha(col,0.1)+';border:1px solid '+hexAlpha(col,0.25)+';">'
          + '<span style="display:inline-block;width:5px;height:5px;border-radius:50%;background:'+col+';margin-right:5px;vertical-align:middle;"></span>'
          + esc(tag) + '</span>';
      });
      html += '<a class="tool-card" href="'+esc(t.url)+'" target="_blank" rel="noopener">'
        + '<div class="tool-card-top"><span class="tool-number">'+pad(i+1)+'</span><span class="tool-arrow">&#8599;</span></div>'
        + '<div class="tool-name">'+esc(t.name)+'</div>'
        + '<div class="tool-desc">'+esc(t.desc)+'</div>'
        + '<div class="tool-author">By <span>'+esc(t.author||'Vendo')+'</span></div>'
        + '<div class="tool-card-footer"><div class="tool-tags">'+tagHtml+'</div></div>'
        + '</a>';
    });
    grid.innerHTML = html;
  }

  // ── MANAGER: TOOLS LIST ──────────────────────────────────────────────
  function renderManagerList() {
    var el = document.getElementById('manager-tools-list');
    if (!tools.length) {
      el.innerHTML = '<div style="font-size:13px;color:var(--text-dim);padding:12px 0">No tools yet.</div>';
      return;
    }
    var html = '';
    tools.forEach(function(t, i) {
      html += '<div class="tool-list-item">'
        + '<span class="tool-list-name">'+esc(t.name)+'</span>'
        + '<span class="tool-list-author">'+esc(t.author||'')+'</span>'
        + '<button class="btn-edit" data-edit="'+i+'">Edit</button>'
        + '<button class="btn-danger" data-idx="'+i+'">Remove</button>'
        + '</div>';
      if (editingIdx === i) {
        var tagCheckboxes = categories.map(function(cat) {
          var col = cat.color;
          var checked = Array.isArray(t.tags) && t.tags.indexOf(cat.name) !== -1;
          var checkedStyle = checked
            ? 'background:'+hexAlpha(col,0.18)+';border-color:'+hexAlpha(col,0.5)+';color:'+col+';'
            : 'border-color:'+hexAlpha(col,0.25)+';color:'+hexAlpha(col,0.7)+';';
          return '<span class="tag-chip edit-tag-chip' + (checked ? ' checked' : '') + '" data-cat="'+esc(cat.name)+'" style="'+checkedStyle+'">'
            + '<span style="display:inline-block;width:5px;height:5px;border-radius:50%;background:'+col+';margin-right:5px;vertical-align:middle;"></span>'
            + esc(cat.name)+'</span>';
        }).join('');

        html += '<div class="edit-row">'
          + '<input class="form-input" id="edit-name-'+i+'" value="'+esc(t.name)+'" placeholder="Tool Name" />'
          + '<input class="form-input" id="edit-url-'+i+'" value="'+esc(t.url)+'" placeholder="URL" />'
          + '<textarea class="form-textarea" id="edit-desc-'+i+'" placeholder="Description">'+esc(t.desc)+'</textarea>'
          + '<input class="form-input" id="edit-author-'+i+'" value="'+esc(t.author||'')+'" placeholder="Author" />'
          + '<div style="margin:8px 0 4px;font-size:11px;font-weight:500;color:var(--text-mid);letter-spacing:0.05em;">Tags</div>'
          + '<div class="tag-chips edit-tag-chips" id="edit-tags-'+i+'" style="margin-bottom:10px;">'+tagCheckboxes+'</div>'
          + '<div class="edit-row-btns">'
          + '<button class="edit-save-btn" data-save="'+i+'">Save</button>'
          + '<button class="edit-cancel-btn" data-cancel="1">Cancel</button>'
          + '</div></div>';
      }
    });
    el.innerHTML = html;
  }

  // ── MANAGER: TAGS ────────────────────────────────────────────────────
  function renderTagColorManager() {
    var el = document.getElementById('tag-color-manager');
    if (!categories.length) {
      el.innerHTML = '<div style="font-size:13px;color:var(--text-dim);padding:8px 0">No tags yet.</div>';
      return;
    }
    var html = '<div style="display:flex;flex-wrap:wrap;gap:8px;">';
    categories.forEach(function(cat, i) {
      html += '<div style="display:inline-flex;align-items:center;gap:8px;background:var(--surface2);border:1px solid var(--border);border-radius:100px;padding:6px 14px 6px 8px;">'
        + '<input type="color" value="'+esc(cat.color)+'" data-cat-idx="'+i+'" title="Change color"'
        + ' style="width:20px;height:20px;border:none;border-radius:50%;cursor:pointer;background:none;padding:0;flex-shrink:0;" />'
        + '<span class="cat-label" style="font-size:13px;color:'+cat.color+';font-weight:500;">'+esc(cat.name)+'</span>'
        + '<button data-del-cat="'+i+'" style="background:none;border:none;color:rgba(255,100,100,0.3);cursor:pointer;font-size:12px;line-height:1;padding:0 0 0 4px;transition:color 0.15s;">&#x2715;</button>'
        + '</div>';
    });
    html += '</div>';
    el.innerHTML = html;
  }

  function renderTagChips() {
    var c = document.getElementById('tag-checkboxes');
    var html = '';
    categories.forEach(function(cat) {
      var col = cat.color;
      html += '<span class="tag-chip" data-cat="'+esc(cat.name)+'" style="border-color:'+hexAlpha(col,0.25)+';color:'+hexAlpha(col,0.75)+';">'
        + '<span style="display:inline-block;width:5px;height:5px;border-radius:50%;background:'+col+';margin-right:5px;vertical-align:middle;"></span>'
        + esc(cat.name)+'</span>';
    });
    c.innerHTML = html;
  }

  function getSelectedTags() {
    var out = [];
    document.querySelectorAll('#tag-checkboxes .tag-chip.checked').forEach(function(el) {
      out.push(el.getAttribute('data-cat'));
    });
    return out;
  }

  // ── ADD CATEGORY ─────────────────────────────────────────────────────
  function addCategory() {
    var input = document.getElementById('new-cat-input');
    var cp    = document.getElementById('new-cat-color');
    var val   = input.value.trim();
    var col   = cp ? cp.value : '#4f9eff';
    if (!val) return;
    for (var i = 0; i < categories.length; i++) {
      if (categories[i].name === val) { input.value = ''; return; }
    }
    categories.push({ name: val, color: col });
    save(); renderTagColorManager(); renderTagChips(); renderFilterBar();
    input.value = '';
  }

  // ── ADD TOOL ─────────────────────────────────────────────────────────
  function addTool() {
    var name   = document.getElementById('new-name').value.trim();
    var url    = document.getElementById('new-url').value.trim();
    var desc   = document.getElementById('new-desc').value.trim();
    var author = document.getElementById('new-author').value.trim();
    var tags   = getSelectedTags();
    if (!name || !url) { alert('Name and URL are required.'); return; }
    tools.push({ id: 't'+Date.now(), name:name, url:url, desc:desc||'No description.', tags:tags.length?tags:['Reporting'], author:author||'Vendo' });
    save(); activeFilter='All'; renderAll();
    ['new-name','new-url','new-desc','new-author'].forEach(function(id){ document.getElementById(id).value=''; });
    renderTagChips();
  }

  // ── TAB SWITCHING ────────────────────────────────────────────────────
  function switchTab(tabId) {
    document.querySelectorAll('.manager-tab').forEach(function(t){ t.classList.remove('active'); });
    document.querySelectorAll('.tab-pane').forEach(function(p){ p.classList.remove('active'); });
    document.querySelector('[data-tab="'+tabId+'"]').classList.add('active');
    document.getElementById('tab-'+tabId).classList.add('active');
    if (tabId === 'tools')    { renderManagerList(); renderTagChips(); }
    if (tabId === 'tags')     { renderTagColorManager(); renderTagChips(); }
    if (tabId === 'publish')  { updatePublishTab(); }
    if (tabId === 'settings') { loadSettingsIntoForm(); }
  }

  // ── OPEN / CLOSE ─────────────────────────────────────────────────────
  function openManager()  {
    switchTab('tools');
    document.getElementById('manager-overlay').classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeManager() {
    document.getElementById('manager-overlay').classList.remove('open');
    document.body.style.overflow = '';
  }

  // ── GITHUB SETTINGS ──────────────────────────────────────────────────
  function ghGetSettings() {
    try {
      return JSON.parse(localStorage.getItem('pltfrm_gh') || 'null');
    } catch(e) { return null; }
  }
  function ghSaveSettings() {
    var s = {
      username: document.getElementById('gh-username').value.trim(),
      repo:     document.getElementById('gh-repo').value.trim(),
      filepath: document.getElementById('gh-filepath').value.trim() || 'index.html',
      token:    document.getElementById('gh-token').value.trim()
    };
    if (!s.username || !s.repo || !s.token) {
      ghMsg('Please fill in username, repo, and token.', 'error'); return;
    }
    localStorage.setItem('pltfrm_gh', JSON.stringify(s));
    ghMsg('Settings saved! Go to the Publish tab to push live.', 'success');
    updatePublishTab();
  }
  function ghClearSettings() {
    if (!confirm('Clear GitHub settings from this browser?')) return;
    localStorage.removeItem('pltfrm_gh');
    ['gh-username','gh-repo','gh-filepath','gh-token'].forEach(function(id) {
      document.getElementById(id).value = '';
    });
    ghMsg('Settings cleared.', 'neutral');
    updatePublishTab();
  }
  function ghMsg(msg, type) {
    var el = document.getElementById('gh-settings-msg');
    el.style.display = 'block';
    el.style.color = type === 'error' ? '#f87171' : type === 'success' ? '#34d399' : 'var(--text-dim)';
    el.textContent = msg;
  }
  function loadSettingsIntoForm() {
    var s = ghGetSettings();
    if (!s) return;
    document.getElementById('gh-username').value = s.username || '';
    document.getElementById('gh-repo').value     = s.repo     || '';
    document.getElementById('gh-filepath').value = s.filepath || 'index.html';
    document.getElementById('gh-token').value    = s.token    || '';
  }
  function updatePublishTab() {
    var s = ghGetSettings();
    var configured = s && s.username && s.repo && s.token;
    document.getElementById('gh-not-configured').style.display = configured ? 'none' : 'block';
    document.getElementById('gh-configured').style.display     = configured ? 'block' : 'none';
    if (configured) {
      document.getElementById('gh-repo-display').textContent  = s.username + ' / ' + s.repo;
      document.getElementById('gh-file-display').textContent  = s.filepath || 'index.html';
    }
  }

  // ── GITHUB PUSH ───────────────────────────────────────────────────────
  function setGhStatus(state, msg) {
    var dot  = document.getElementById('gh-status-dot');
    var text = document.getElementById('gh-status-text');
    dot.className  = 'gh-status-dot' + (state ? ' ' + state : '');
    text.textContent = msg;
  }

  function buildExportHTML() {
    var html = document.documentElement.outerHTML;
    html = html.replace(/var DEFAULT_PALETTE = \[[\s\S]*?\];/, 'var DEFAULT_PALETTE = ' + JSON.stringify(categories, null, 2) + ';');
    html = html.replace(/var DEFAULT_TOOLS = \[[\s\S]*?\];/,   'var DEFAULT_TOOLS = '   + JSON.stringify(tools, null, 2)      + ';');
    html = html.replace(
      /var tools, categories;[\s\S]*?categories = JSON\.parse\(JSON\.stringify\(DEFAULT_PALETTE\)\);\s*\} catch[\s\S]*?\}/,
      'var tools = JSON.parse(JSON.stringify(DEFAULT_TOOLS));\n  var categories = JSON.parse(JSON.stringify(DEFAULT_PALETTE));'
    );
    return '<!DOCTYPE html>\n' + html.replace(/^<!DOCTYPE html>\n?/i, '');
  }

  function pushToGitHub() {
    var s = ghGetSettings();
    if (!s || !s.token) { alert('Configure GitHub settings first.'); return; }

    var btn = document.getElementById('gh-push-btn');
    btn.disabled = true;
    btn.textContent = 'Pushing…';
    setGhStatus('pushing', 'Pushing to GitHub…');

    var filepath = s.filepath || 'index.html';
    var apiBase  = 'https://api.github.com/repos/' + s.username + '/' + s.repo + '/contents/' + filepath;
    var headers  = {
      'Authorization': 'token ' + s.token,
      'Content-Type': 'application/json',
      'Accept': 'application/vnd.github.v3+json'
    };

    function onError(msg) {
      setGhStatus('error', 'Error: ' + msg);
      btn.disabled = false;
      btn.innerHTML = '&#8599;&nbsp; Push to GitHub';
    }

    function onSuccess() {
      setGhStatus('success', 'Pushed! Site will update in ~30 seconds.');
      btn.textContent = '✓ Pushed successfully';
      setTimeout(function() {
        btn.disabled = false;
        btn.innerHTML = '&#8599;&nbsp; Push to GitHub';
        setGhStatus('', 'Ready to push');
      }, 4000);
    }

    function doPush(sha) {
      var content = buildExportHTML();
      var encoded;
      try {
        encoded = btoa(unescape(encodeURIComponent(content)));
      } catch(e) {
        onError('Failed to encode file: ' + e.message); return;
      }
      var body = { message: 'Update tools via PLTFRM page manager', content: encoded };
      if (sha) body.sha = sha;

      fetch(apiBase, { method: 'PUT', headers: headers, body: JSON.stringify(body) })
        .then(function(res) {
          if (!res.ok) {
            return res.json().then(function(d) { throw new Error(d.message || res.statusText); });
          }
          onSuccess();
        })
        .catch(function(err) { onError(err.message); });
    }

    // Step 1: get current SHA
    fetch(apiBase, { headers: headers })
      .then(function(res) {
        if (res.status === 404) { doPush(null); return; }
        if (!res.ok) throw new Error('Could not read file: ' + res.status + ' ' + res.statusText);
        return res.json().then(function(d) { doPush(d.sha); });
      })
      .catch(function(err) { onError(err.message); });
  }

  function exportHTML() {
    var content = buildExportHTML();
    var blob = new Blob([content], {type:'text/html'});
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'index.html';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
  }

  function renderAll() { renderFilterBar(); renderGrid(); renderManagerList(); }

  // ── EVENT DELEGATION ─────────────────────────────────────────────────
  // Filter bar
  document.getElementById('filter-bar').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-cat]');
    if (!btn) return;
    activeFilter = btn.getAttribute('data-cat');
    renderFilterBar(); renderGrid();
  });

  // Search
  document.getElementById('search-input').addEventListener('input', function() {
    var hasVal = this.value.length > 0;
    document.getElementById('search-clear').style.display = hasVal ? 'block' : 'none';
    renderGrid();
  });
  document.getElementById('search-clear').addEventListener('click', function() {
    document.getElementById('search-input').value = '';
    this.style.display = 'none';
    document.getElementById('search-input').focus();
    renderGrid();
  });

  // Sort
  document.getElementById('sort-select').addEventListener('change', renderGrid);

  // Filter toggle
  document.getElementById('filter-toggle-btn').addEventListener('click', toggleFilter);

  // Manager header buttons
  document.getElementById('open-manager-btn').addEventListener('click', openManager);
  document.getElementById('close-manager-btn').addEventListener('click', closeManager);
  document.getElementById('manager-overlay').addEventListener('click', function(e){ if (e.target===this) closeManager(); });

  // Tabs
  document.querySelector('.manager-tabs').addEventListener('click', function(e) {
    var btn = e.target.closest('.manager-tab');
    if (btn) switchTab(btn.getAttribute('data-tab'));
  });

  // Tools list — edit / save / cancel / remove
  document.getElementById('manager-tools-list').addEventListener('click', function(e) {
    var editChip = e.target.closest('.edit-tag-chip');
    if (editChip) {
      editChip.classList.toggle('checked');
      var col = getCatColor(editChip.getAttribute('data-cat'));
      if (editChip.classList.contains('checked')) {
        editChip.style.background = hexAlpha(col,0.18);
        editChip.style.borderColor = hexAlpha(col,0.5);
        editChip.style.color = col;
      } else {
        editChip.style.background = '';
        editChip.style.borderColor = hexAlpha(col,0.25);
        editChip.style.color = hexAlpha(col,0.7);
      }
      return;
    }
    var removeBtn = e.target.closest('[data-idx]');
    if (removeBtn) {
      var idx = parseInt(removeBtn.getAttribute('data-idx'), 10);
      if (confirm('Remove "'+tools[idx].name+'"?')) {
        tools.splice(idx,1); editingIdx=-1; save(); activeFilter='All'; renderAll();
      }
      return;
    }
    var editBtn = e.target.closest('[data-edit]');
    if (editBtn) {
      var idx = parseInt(editBtn.getAttribute('data-edit'), 10);
      editingIdx = editingIdx === idx ? -1 : idx;
      renderManagerList(); return;
    }
    var saveBtn = e.target.closest('[data-save]');
    if (saveBtn) {
      var idx = parseInt(saveBtn.getAttribute('data-save'), 10);
      var n = document.getElementById('edit-name-'+idx).value.trim();
      var u = document.getElementById('edit-url-'+idx).value.trim();
      var d = document.getElementById('edit-desc-'+idx).value.trim();
      var a = document.getElementById('edit-author-'+idx).value.trim();
      if (!n||!u) { alert('Name and URL are required.'); return; }
      // Read checked edit tag chips
      var newTags = [];
      document.querySelectorAll('#edit-tags-'+idx+' .edit-tag-chip.checked').forEach(function(chip) {
        newTags.push(chip.getAttribute('data-cat'));
      });
      tools[idx].name=n; tools[idx].url=u; tools[idx].desc=d; tools[idx].author=a;
      tools[idx].tags = newTags.length ? newTags : tools[idx].tags;
      editingIdx=-1; save(); renderAll(); return;
    }
    if (e.target.closest('[data-cancel]')) { editingIdx=-1; renderManagerList(); }
  });

  // Tag chips (add tool)
  document.getElementById('tag-checkboxes').addEventListener('click', function(e) {
    var chip = e.target.closest('.tag-chip');
    if (!chip) return;
    chip.classList.toggle('checked');
    var col = getCatColor(chip.getAttribute('data-cat'));
    if (chip.classList.contains('checked')) {
      chip.style.background = hexAlpha(col,0.18);
      chip.style.borderColor = hexAlpha(col,0.5);
      chip.style.color = col;
    } else {
      chip.style.background = '';
      chip.style.borderColor = hexAlpha(col,0.25);
      chip.style.color = hexAlpha(col,0.75);
    }
  });

  // Tag color manager
  document.getElementById('tag-color-manager').addEventListener('input', function(e) {
    var inp = e.target.closest('[data-cat-idx]');
    if (!inp) return;
    var idx = parseInt(inp.getAttribute('data-cat-idx'), 10);
    categories[idx].color = inp.value;
    var label = inp.parentElement.querySelector('.cat-label');
    if (label) label.style.color = inp.value;
  });
  document.getElementById('tag-color-manager').addEventListener('change', function(e) {
    if (!e.target.closest('[data-cat-idx]')) return;
    save(); renderFilterBar(); renderGrid();
  });
  document.getElementById('tag-color-manager').addEventListener('click', function(e) {
    var btn = e.target.closest('[data-del-cat]');
    if (!btn) return;
    var idx = parseInt(btn.getAttribute('data-del-cat'), 10);
    var name = categories[idx].name;
    if (confirm('Delete tag "'+name+'"?')) {
      categories.splice(idx,1);
      tools.forEach(function(t){ if (Array.isArray(t.tags)) t.tags=t.tags.filter(function(tg){return tg!==name;}); });
      save(); activeFilter='All'; renderAll(); renderTagColorManager(); renderTagChips();
    }
  });

  // ── SAFE EVENT BINDING ───────────────────────────────────────────────
  function on(id, evt, fn) {
    var el = document.getElementById(id);
    if (el) el.addEventListener(evt, fn);
  }

  // Add tool / add category / export
  on('add-tool-btn', 'click', addTool);
  on('add-cat-btn',  'click', addCategory);
  on('export-btn',   'click', exportHTML);
  on('new-cat-input','keydown', function(e){ if(e.key==='Enter'){e.preventDefault();addCategory();} });

  // GitHub
  on('gh-push-btn',          'click', pushToGitHub);
  on('gh-save-settings-btn', 'click', ghSaveSettings);
  on('gh-clear-settings-btn','click', ghClearSettings);
  on('gh-token-toggle',      'click', function() {
    var inp = document.getElementById('gh-token');
    if (!inp) return;
    var isHidden = inp.type === 'password';
    inp.type = isHidden ? 'text' : 'password';
    this.textContent = isHidden ? 'Hide' : 'Show';
  });

  // Close buttons — delegate to closeManager (already bound above)

  // ── INIT ─────────────────────────────────────────────────────────────
  renderFilterBar();
  renderGrid();

})();
</script>


</body></html>
